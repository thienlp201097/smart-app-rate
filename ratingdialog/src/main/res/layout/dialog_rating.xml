<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    app:cardCornerRadius="@dimen/_20sdp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:background="@drawable/rounded_rectangle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:src="@drawable/wave"
            android:scaleType="fitXY"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:padding="@dimen/_10sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true">

            <ImageView
                android:id="@+id/dialog_rating_icon"
                android:layout_width="@dimen/_75sdp"
                android:layout_height="@dimen/_75sdp"
                android:layout_centerHorizontal="true"
                android:src="@drawable/rate_0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/dialog_rating_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/dialog_rating_icon"
                android:layout_centerHorizontal="true"
                android:fontFamily="@font/inter_medium"
                android:gravity="center"
                android:lines="2"
                android:maxLines="2"
                android:text="Making things better."
                android:textColor="#212121"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@+id/dialog_rating_icon"
                tools:layout_editor_absoluteX="13dp" />

            <TextView
                android:id="@+id/dialog_rating_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/dialog_rating_title"
                android:layout_centerHorizontal="true"
                android:fontFamily="@font/inter_medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="We’d greatly appreciate if you can rate us ."
                android:textColor="#3252BF"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@+id/dialog_rating_title"
                tools:layout_editor_absoluteX="13dp" />

            <com.willy.ratingbar.ScaleRatingBar
                android:id="@+id/dialog_rating_rating_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/dialog_rating_content"
                android:layout_centerHorizontal="true"
                app:layout_constraintEnd_toEndOf="@+id/dialog_rating_icon"
                app:layout_constraintStart_toStartOf="@+id/dialog_rating_icon"
                app:layout_constraintTop_toBottomOf="@+id/dialog_rating_content"
                app:srb_clearRatingEnabled="false"
                app:srb_clickable="true"
                android:layout_marginTop="@dimen/_5sdp"
                app:srb_isIndicator="false"
                app:srb_minimumStars="0"
                app:srb_numStars="5"
                app:srb_rating="0"
                app:srb_scrollable="true"
                app:srb_starHeight="@dimen/_24sdp"
                app:srb_starWidth="@dimen/_24sdp"
                app:srb_stepSize="1"/>

            <ImageView
                android:id="@+id/star2"
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_50sdp"
                android:layout_below="@+id/dialog_rating_title"
                android:layout_toEndOf="@+id/dialog_rating_rating_bar"
                android:src="@drawable/abc"
                app:layout_constraintBottom_toBottomOf="@+id/dialog_rating_rating_bar"
                app:layout_constraintStart_toEndOf="@+id/dialog_rating_rating_bar" />


            <!--        app:srb_drawableEmpty="@drawable/start_empty"-->
            <!--        app:srb_drawableFilled="@drawable/star_filled"-->

            <TextView
                android:id="@+id/tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/dialog_rating_rating_bar"
                android:layout_centerHorizontal="true"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:text="The best we can get :)    "
                android:textColor="#001FC1"
                android:textSize="12sp"
                android:layout_marginTop="@dimen/_8sdp"
                app:layout_constraintEnd_toEndOf="@+id/dialog_rating_rating_bar"
                app:layout_constraintStart_toStartOf="@+id/dialog_rating_rating_bar"
                app:layout_constraintTop_toBottomOf="@+id/dialog_rating_rating_bar" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRate"
                android:layout_width="0dp"
                android:layout_height="@dimen/_35sdp"
                android:layout_below="@+id/tv"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_centerHorizontal="true"
                android:background="@drawable/bg_button"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:text="Rate"
                android:textColor="@color/white"
                app:layout_constraintEnd_toEndOf="@+id/dialog_rating_rating_bar"
                app:layout_constraintStart_toStartOf="@+id/dialog_rating_rating_bar"
                app:layout_constraintTop_toBottomOf="@+id/tv" />


            <TextView
                android:id="@+id/btnLate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/btnRate"
                android:fontFamily="@font/inter_medium"
                android:gravity="center"
                android:text="Maybe Later"
                android:textColor="#5F5F5F"
                android:textSize="14sp"
                android:layout_marginTop="@dimen/_5sdp"
                app:layout_constraintTop_toBottomOf="@+id/btnRate"
                tools:layout_editor_absoluteX="13dp" />


            <LinearLayout
                android:id="@+id/dialog_rating_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/dialog_rating_rating_bar"
                android:layout_marginTop="15dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/dialog_rating_button_negative"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:gravity="center"
                    android:padding="15dp"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/dialog_rating_button_positive"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:gravity="center"
                    android:padding="15dp"
                    android:textSize="15sp" />

            </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>
    </RelativeLayout>


</androidx.cardview.widget.CardView>
